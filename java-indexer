#!/bin/sh
# Java launcher used by OpenGrok's Python tools (indexer, index check).
# Tomcat uses $JAVA_HOME/bin/java directly and is not affected.
# If the service runs out of memory, the kernel should stop a reindex
# (it is retried on the next sync) rather than the web app.
echo 1000 > /proc/self/oom_score_adj 2>/dev/null
exec /opt/java/openjdk/bin/java "$@"
